{
  "name": "legion-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The legion viewer frontend — a read-only projection of legion3's manifests. Build-time deps only; `legion viewer` serves the built bundle from node: builtins.",
