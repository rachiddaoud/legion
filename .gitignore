node_modules/
.DS_Store

# The viewer is a BUILT-ON-DEMAND bundle (c13; PLAN-V3 decision 12). Its build-time dependencies
# and its output never enter the repository: the root package.json's zero-runtime-dependency
# property is a stated repo property, viewer/package-lock.json IS committed so the build stays
# reproducible, and `legion viewer` refuses loudly (naming the two commands that fix it) when the
# bundle is absent rather than serving a blank page. Landed with the server, BEFORE the first
# build exists, so neither directory can ever be staged by accident.
viewer/dist/
viewer/node_modules/

# The build's concurrency lock (LOCK_FILE, src/cli/_viewer-bundle.mjs): machine-local, transient,
# and left behind by any hard-killed build until the next one reclaims it. Ignored for the same
# reason the digest walk excludes it — it is a fact about a running process, never a bundle input.
viewer/.legion-build-lock

# ONE LOCKFILE, and it is viewer/package-lock.json. The bundle builds on the OPERATOR's machine,
# so it may only depend on what a legion install already requires: npm ships with Node (package.json
# pins >=22) and pnpm does not, and pnpm additionally blocks the postinstall scripts esbuild needs.
# Use pnpm locally if you prefer it — it reads the npm lockfile fine — but its lockfile never lands,
# because two lockfiles means the reproducibility this file claims depends on which command ran.
viewer/pnpm-lock.yaml
viewer/pnpm-workspace.yaml
